# Copy to .env if you want to change anything. Every line is optional.
# Port on your machine that maps to the app.
VAULT_PORT=8090
# Leave empty for a private localhost install. Set a long random string before exposing it anywhere.
# A token also switches on the bookmarklet endpoint.
VAULT_TOKEN=
# Websites that may call the API from a browser, comma separated.
VAULT_ALLOWED_ORIGINS=https://aariv.me
# When to write a database backup (cron syntax, container time).
VAULT_BACKUP_CRON=0 3 * * *
TZ=UTC
